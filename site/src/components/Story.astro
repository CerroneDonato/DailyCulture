---
import ArticleVisual from "./ArticleVisual.astro";
import { formatLongDate, type Article } from "../lib/archive";
import type { ArticleImage } from "../lib/images";

interface Props {
  article: Article & { image: ArticleImage | null };
}

const { article } = Astro.props;
const [first, ...restParagraphs] = article.paragraphs;
const isWords = article.category.key === "parole";
---

<article class="story" style={`--cat:${article.category.color}`}>
  <header class="story-head">
    <a href={`/sezioni/${article.category.key}/`} class="kicker">{article.category.emoji} {article.category.label}</a>
    <h1>{article.title}</h1>
    {article.subtitle && <p class="story-sub">{article.subtitle}</p>}
    <p class="meta story-meta">
      <a href={`/archive/${article.issueSlug}/`}>{formatLongDate(article.date)}</a>
      <span>·</span>
      <span>{article.readingMinutes} min di lettura</span>
      {article.theme && (<><span>·</span><span>Tema: <em>{article.theme}</em></span></>)}
      {article.liked && <span class="badge-liked">Il preferito</span>}
    </p>
  </header>

  {!isWords && (
    <div class="story-hero">
      <ArticleVisual image={article.image} category={article.category} title={article.title} frame="hero" eager caption />
    </div>
  )}

  <div class="story-layout">
    <div class="story-body">
      {isWords ? (
        <div class="words">
          {article.paragraphs.map((p) => (
            <section class="word">
              {p.h && <h2>{p.h}</h2>}
              <p set:html={p.html} />
            </section>
          ))}
        </div>
      ) : (
        <>
          {first && (
            <>
              {first.h && <h2>{first.h}</h2>}
              <p class="dropcap" set:html={first.html} />
            </>
          )}
          {restParagraphs.map((p, i) => (
            <>
              {p.h && <h2>{p.h}</h2>}
              <p set:html={p.html} />
              {i === 0 && article.recap && restParagraphs.length > 2 && (
                <blockquote class="pullquote">{article.recap.split(/(?<=\.)\s/)[0]}</blockquote>
              )}
            </>
          ))}
        </>
      )}

      {article.challenge && (
        <aside class="challenge">
          <span class="kicker">🧩 Prova tu</span>
          <p>{article.challenge}</p>
          {article.solution && (
            <details>
              <summary>Mostra la soluzione</summary>
              <p>{article.solution}</p>
            </details>
          )}
        </aside>
      )}

      {(article.link || article.sources.length > 0) && (
        <div class="story-links">
          {article.link && (
            <a href={article.link.url} class="button" rel="noopener" target="_blank">{article.link.label} ↗</a>
          )}
          {article.sources.length > 0 && (
            <ul class="sources">
              {article.sources.map((s) => (
                <li>Fonte: <a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>
              ))}
            </ul>
          )}
        </div>
      )}
    </div>

    <aside class="story-aside">
      {article.facts.length > 0 && (
        <div class="factbox">
          <h3>La scheda</h3>
          <dl>
            {article.facts.map((f) => (
              <>
                <dt>{f.k}</dt>
                <dd>{f.v}</dd>
              </>
            ))}
          </dl>
        </div>
      )}
      {article.recap && (
        <div class="recap">
          <h3>📌 Da ricordare</h3>
          <p>{article.recap}</p>
        </div>
      )}
    </aside>
  </div>
</article>

<style>
  .story-head { max-width: 52rem; margin: 0.4rem auto 1.2rem; text-align: center; }
  .story-head h1 { font-size: clamp(1.85rem, 7vw, 4rem); line-height: 1.08; margin: 0.45rem 0 0.55rem; letter-spacing: -0.01em; }
  .story-sub { font-size: 1.08rem; font-style: italic; color: var(--ink-2); margin: 0 0 0.7rem; line-height: 1.4; }
  .story-meta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.4rem 0.5rem; text-transform: capitalize; }
  .story-meta em { text-transform: none; font-family: var(--serif); font-size: 0.85rem; }
  .story-meta a:hover { text-decoration: underline; }

  .story-hero { margin: 0 auto 1.3rem; }

  .story-layout {
    display: grid;
    grid-template-columns: minmax(0, 42rem) minmax(0, 18rem);
    justify-content: center;
    gap: 3.5rem;
  }

  .story-body { font-size: 1.05rem; line-height: 1.6; }
  .story-body h2 { font-size: 1.35rem; margin: 1.6rem 0 0.45rem; }
  .story-body h2:first-child { margin-top: 0; }
  .story-body p { margin: 0 0 1rem; }
  .story-body :global(strong) { font-weight: 600; background: linear-gradient(transparent 62%, color-mix(in srgb, var(--cat) 18%, transparent) 62%); }
  .dropcap::first-letter {
    float: left;
    font-family: var(--serif-display);
    font-weight: 900;
    font-size: 3.4rem;
    line-height: 0.82;
    padding: 0.28rem 0.45rem 0 0;
    color: var(--cat);
  }

  .pullquote {
    margin: 1.4rem 0;
    padding: 0.9rem 0;
    border-top: 3px solid var(--cat);
    border-bottom: 1px solid var(--rule);
    font-family: var(--serif-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.3;
  }

  .words { display: flex; flex-direction: column; gap: 1.3rem; }
  .word { border-left: 4px solid var(--cat); padding-left: 1rem; }
  .word h2 { font-size: 1.7rem; margin: 0 0 0.3rem !important; font-style: italic; }

  .challenge { background: var(--card); border: 1px solid var(--rule); border-top: 4px solid var(--cat); padding: 1.1rem 1.15rem; margin: 1.4rem 0; }
  .challenge p { margin: 0.5rem 0; }
  .challenge summary { cursor: pointer; font-family: var(--sans); font-size: 0.85rem; font-weight: 600; color: var(--accent); min-height: 44px; display: flex; align-items: center; }
  .challenge details p { background: var(--paper-2); padding: 0.8rem 1rem; margin-top: 0.4rem; font-size: 1rem; }

  .story-links { display: flex; flex-direction: column; gap: 0.8rem; border-top: 1px solid var(--rule); padding-top: 1.2rem; margin-top: 1.4rem; }
  .story-links .button { align-self: flex-start; min-height: 44px; }
  .sources { margin: 0; padding: 0; list-style: none; font-family: var(--sans); font-size: 0.8rem; color: var(--muted); }
  .sources a { color: var(--ink); text-decoration: underline; }

  .story-aside { display: flex; flex-direction: column; gap: 1.2rem; }
  .factbox { background: var(--card); padding: 1rem 1.1rem; border: 1px solid var(--rule); border-top: 4px solid var(--cat); }
  .factbox h3, .recap h3 { font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.7rem; }
  .factbox dl { margin: 0; }
  .factbox dt { font-family: var(--sans); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .factbox dd { margin: 0.1rem 0 0.7rem; font-weight: 600; line-height: 1.35; }
  .factbox dd:last-child { margin-bottom: 0; }
  .recap { background: var(--ink); color: var(--paper); padding: 1.1rem; }
  .recap p { margin: 0; font-size: 0.98rem; line-height: 1.55; }

  @media (min-width: 801px) {
    .story-head { margin: 1rem auto 2rem; }
    .story-sub { font-size: clamp(1.15rem, 2vw, 1.45rem); }
    .story-body { font-size: 1.12rem; line-height: 1.7; }
    .story-hero { max-width: 64rem; margin-bottom: 2.2rem; }
    .dropcap::first-letter { font-size: 4.4rem; }
    .factbox { position: sticky; top: 1.5rem; }
  }

  @media (max-width: 800px) {
    .story-layout { grid-template-columns: 1fr; gap: 1.2rem; }
    .story-aside { order: -1; }
  }
</style>
