---
import type { Category } from "../lib/archive";
import type { ArticleImage } from "../lib/images";

interface Props {
  image: ArticleImage | null;
  category: Category;
  title: string;
  frame?: "hero" | "card" | "thumb" | "wide";
  eager?: boolean;
  caption?: boolean;
}

const { image, category, title, frame = "card", eager = false, caption = false } = Astro.props;
---

<figure class:list={["visual", `visual-${frame}`]} style={`--cat:${category.color}`}>
  <div class="frame">
    {image ? (
      <img
        src={image.src}
        alt={title}
        width={image.width}
        height={image.height}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        referrerpolicy="no-referrer"
      />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <span class="placeholder-emoji">{category.emoji}</span>
        <span class="placeholder-label">{category.short}</span>
      </div>
    )}
  </div>
  {caption && image && (
    <figcaption>
      Foto: <a href={image.creditUrl} rel="noopener" target="_blank">{image.credit}</a>
    </figcaption>
  )}
</figure>

<style>
  .visual { margin: 0; }
  .frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    max-height: var(--cap);
    background: var(--paper-2);
  }
  .visual-hero { --ratio: 4 / 5; --cap: 46vh; }
  .visual-card { --ratio: 3 / 2; --cap: 30vh; }
  .visual-wide { --ratio: 16 / 9; --cap: 34vh; }
  .visual-thumb { --ratio: 1 / 1; --cap: 92px; }

  .frame img,
  .placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .frame img { filter: saturate(0.92) contrast(1.02); }
  .placeholder {
    display: grid;
    place-items: center;
    color: #fff;
    background:
      radial-gradient(circle at 20% 15%, rgba(255, 255, 255, 0.18), transparent 45%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0 2px, transparent 2px 14px),
      linear-gradient(140deg, var(--cat), color-mix(in srgb, var(--cat) 55%, #000));
  }
  .placeholder-emoji { font-size: clamp(2rem, 8vw, 3.4rem); filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.3)); }
  .placeholder-label {
    position: absolute;
    left: 0.8rem;
    bottom: 0.55rem;
    font-family: var(--serif-display);
    font-style: italic;
    font-size: 1rem;
    opacity: 0.9;
  }
  figcaption {
    font-family: var(--sans);
    font-size: 0.7rem;
    color: var(--muted);
    padding: 0.4rem 0;
  }
  figcaption a:hover { text-decoration: underline; }

  @media (min-width: 801px) {
    .visual-hero { --ratio: 16 / 9; --cap: 62vh; }
    .visual-card { --cap: 220px; }
    .visual-wide { --cap: 260px; }
  }
</style>
