---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Story from "../../components/Story.astro";
import { getArticles, getIssues, type Article } from "../../lib/archive";
import { withImages } from "../../lib/images";

export async function getStaticPaths() {
  return getArticles().map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const issue = getIssues().find((item) => item.slug === article.issueSlug);
const edition = await withImages(issue?.articles?.length ? issue.articles : [article]);
const index = Math.max(0, edition.findIndex((item) => item.slug === article.slug));
const current = edition[index];
const previous = edition[index - 1];
const following = edition[index + 1];
---

<BaseLayout
  pageTitle={`${current.title} · DailyCulture`}
  description={current.subtitle || current.excerpt}
  image={current.image?.src}
  activeSection={current.category.key}
>
  <div
    class="edition-reader"
    data-start={index}
    data-count={edition.length}
    style={`--i:${index};--n:${edition.length}`}
  >
    <div class="reader-bar">
      <a class="reader-back" href={`/archive/${current.issueSlug}/`} aria-label="Torna all’edizione">←</a>
      <div class="reader-now">
        <span class="reader-section" style={`--cat:${current.category.color}`}>{current.category.emoji} {current.category.short}</span>
        <span class="reader-count">{index + 1} di {edition.length}</span>
      </div>
      <span class="reader-hint">{following ? `poi ${following.category.short}` : "fine"}</span>
      <div class="reader-dots">
        {edition.map((item, dot) => (
          <button
            type="button"
            class:list={["dot", { on: dot === index }]}
            style={`--cat:${item.category.color}`}
            data-go={dot}
            aria-label={`${item.category.short}: ${item.title}`}
          />
        ))}
      </div>
    </div>

    <div class="swipe-hint" aria-hidden="true">Scorri per il prossimo articolo <span>→</span></div>

    <div class="reader-viewport">
      <div class="reader-track">
        {edition.map((item, position) => (
          <div
            class:list={["reader-slide", { "is-current": position === index }]}
            data-url={`/articoli/${item.slug}/`}
            data-title={`${item.title} · DailyCulture`}
            data-section={`${item.category.emoji} ${item.category.short}`}
            data-hint={edition[position + 1] ? `poi ${edition[position + 1].category.short}` : "fine"}
            data-cat={item.category.color}
          >
            <Story article={item} />
          </div>
        ))}
      </div>
    </div>
  </div>

  <nav class="edition-pager" aria-label="Articoli dell’edizione">
    {previous ? (
      <a class="pager-link" href={`/articoli/${previous.slug}/`}>
        <span>← Precedente</span>
        <strong>{previous.category.short}</strong>
        {previous.title}
      </a>
    ) : <span />}
    <a class="pager-edition" href={`/archive/${current.issueSlug}/`}>Edizione</a>
    {following ? (
      <a class="pager-link next" href={`/articoli/${following.slug}/`}>
        <span>Successivo →</span>
        <strong>{following.category.short}</strong>
        {following.title}
      </a>
    ) : <span />}
  </nav>
</BaseLayout>

<script>
  const reader = document.querySelector<HTMLElement>(".edition-reader");
  const viewport = reader?.querySelector<HTMLElement>(".reader-viewport");
  const slides = viewport ? [...viewport.querySelectorAll<HTMLElement>(".reader-slide")] : [];
  const narrow = window.matchMedia("(max-width: 800px)");
  let currentIndex = Number(reader?.dataset.start || 0);

  function apply(index: number, updateUrl: boolean) {
    if (!reader || !slides.length) return;
    const next = Math.max(0, Math.min(slides.length - 1, index));
    currentIndex = next;
    slides.forEach((slide, position) => slide.classList.toggle("is-current", position === next));
    const slide = slides[next];
    const section = document.querySelector<HTMLElement>(".reader-section");
    const count = document.querySelector<HTMLElement>(".reader-count");
    const hint = document.querySelector<HTMLElement>(".reader-hint");
    if (section) {
      section.textContent = slide.dataset.section || "";
      section.style.setProperty("--cat", slide.dataset.cat || "");
    }
    if (count) count.textContent = `${next + 1} di ${slides.length}`;
    if (hint) hint.textContent = slide.dataset.hint || "";
    document.querySelectorAll(".reader-dots .dot").forEach((dot, position) => {
      dot.classList.toggle("on", position === next);
    });
    if (updateUrl && slide.dataset.url && location.pathname !== slide.dataset.url) {
      history.replaceState(null, "", slide.dataset.url);
      if (slide.dataset.title) document.title = slide.dataset.title;
    }
  }

  function jumpTo(index: number) {
    if (!viewport) return;
    viewport.style.scrollBehavior = "auto";
    viewport.scrollLeft = index * viewport.clientWidth;
    viewport.style.scrollBehavior = "";
  }

  if (reader && viewport && slides.length > 1) {
    reader.classList.add("is-ready");
    if (narrow.matches) requestAnimationFrame(() => jumpTo(currentIndex));

    let settle = 0;
    viewport.addEventListener("scroll", () => {
      if (!narrow.matches) return;
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        const index = Math.round(viewport.scrollLeft / viewport.clientWidth);
        if (index !== currentIndex) {
          apply(index, true);
          localStorage.setItem("dc-swiped", "1");
          reader.classList.remove("show-hint");
        }
      }, 90);
    }, { passive: true });

    reader.querySelectorAll<HTMLElement>("[data-go]").forEach((dot) => {
      dot.addEventListener("click", () => {
        const index = Number(dot.dataset.go);
        if (narrow.matches) viewport.scrollTo({ left: index * viewport.clientWidth, behavior: "smooth" });
        else location.href = slides[index].dataset.url || location.href;
      });
    });

    window.addEventListener("resize", () => { if (narrow.matches) jumpTo(currentIndex); });

    if (narrow.matches && !localStorage.getItem("dc-swiped") && currentIndex < slides.length - 1) {
      reader.classList.add("show-hint");
      window.setTimeout(() => reader.classList.remove("show-hint"), 4500);
    }
  }
</script>

<style>
  .edition-reader { --i: 0; --n: 1; }

  .reader-bar { display: none; }

  .edition-pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: start;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 3px double var(--ink);
  }
  .pager-link, .pager-edition {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: 44px;
    font-family: var(--sans);
  }
  .pager-link span, .pager-edition { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .pager-link strong { font-family: var(--serif-display); font-size: 1.15rem; color: var(--ink); text-transform: none; letter-spacing: 0; }
  .pager-link { color: var(--ink-2); font-size: 0.92rem; }
  .pager-link.next { text-align: right; align-items: flex-end; }
  .pager-edition { align-self: center; justify-content: center; }
  .pager-link:hover strong { color: var(--accent); }

  @media (max-width: 800px) {
    :global(body:has(.edition-reader)) {
      overflow: hidden;
      height: 100dvh;
    }
    :global(body:has(.edition-reader) .topbar),
    :global(body:has(.edition-reader) .masthead),
    :global(body:has(.edition-reader) .sections),
    :global(body:has(.edition-reader) .site-footer) { display: none; }
    :global(body:has(.edition-reader) main.wrap) {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      height: 100dvh;
    }

    .edition-pager { display: none; }

    .edition-reader {
      height: 100dvh;
      display: flex;
      flex-direction: column;
      background: var(--paper);
    }
    .reader-bar {
      display: grid;
      grid-template-columns: 44px 1fr auto;
      grid-template-areas: "back now hint" "dots dots dots";
      align-items: center;
      gap: 0.35rem 0.6rem;
      padding: calc(0.35rem + env(safe-area-inset-top)) 0.7rem 0.45rem;
      background: var(--ink);
      color: #f6f1e7;
      z-index: 5;
    }
    .reader-back {
      grid-area: back;
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      color: #fff;
      font-size: 1.4rem;
    }
    .reader-now { grid-area: now; display: flex; flex-direction: column; min-width: 0; }
    .reader-section {
      font-family: var(--sans);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .reader-count { font-family: var(--sans); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: #b7ad9e; }
    .reader-hint {
      grid-area: hint;
      font-family: var(--sans);
      font-size: 0.72rem;
      font-weight: 600;
      color: #f0b9a8;
      text-align: right;
    }
    .reader-dots { grid-area: dots; display: flex; justify-content: center; gap: 0.15rem; }
    .dot {
      width: 22px;
      height: 18px;
      padding: 0;
      border: 0;
      background: none;
      display: grid;
      place-items: center;
      cursor: pointer;
    }
    .dot::before { content: ""; width: 7px; height: 7px; border-radius: 99px; background: #4a463f; transition: width 0.2s, background 0.2s; }
    .dot.on::before { width: 18px; background: var(--cat, #f0b9a8); }

    .reader-viewport {
      flex: 1;
      min-height: 0;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .reader-viewport::-webkit-scrollbar { display: none; }
    .reader-track { display: flex; height: 100%; }
    .reader-slide {
      flex: 0 0 100vw;
      width: 100vw;
      height: 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior-y: contain;
      padding: 0.8rem 1.05rem calc(1.4rem + env(safe-area-inset-bottom));
      -webkit-overflow-scrolling: touch;
    }
    .reader-slide + .reader-slide { border-left: 1px solid var(--rule); }

    .swipe-hint {
      position: fixed;
      left: 50%;
      bottom: calc(1.2rem + env(safe-area-inset-bottom));
      transform: translate(-50%, 1rem);
      opacity: 0;
      pointer-events: none;
      background: var(--ink);
      color: #fff;
      font-family: var(--sans);
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.6rem 1rem;
      border-radius: 99px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
      transition: opacity 0.3s, transform 0.3s;
      z-index: 10;
      white-space: nowrap;
    }
    .swipe-hint span { display: inline-block; animation: nudge 1s ease-in-out infinite; }
    .show-hint .swipe-hint { opacity: 1; transform: translate(-50%, 0); }
    @keyframes nudge { 50% { transform: translateX(5px); } }
  }

  @media (min-width: 801px) {
    .swipe-hint { display: none; }
    .reader-track { display: block; }
    .reader-slide { display: none; }
    .reader-slide.is-current { display: block; }
  }
</style>
