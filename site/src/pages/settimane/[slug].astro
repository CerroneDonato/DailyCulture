---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getWeeklySummaries } from "../../lib/archive";

export async function getStaticPaths() {
  return getWeeklySummaries().map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<BaseLayout pageTitle={`${entry.label} • DailyCulture`} description={entry.excerpt}>
  <article class="article">
    <p class="eyebrow">Settimana tematica</p>
    <h1>{entry.label}</h1>
    <div class="markdown-body" set:html={entry.html}></div>
    <div class="article-actions">
      <a href="/settimane/">Torna alle settimane</a>
      <a href="/">Homepage</a>
    </div>
  </article>
</BaseLayout>
